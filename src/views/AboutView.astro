---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, pageUrl } from '../i18n';
import { categories, type Lang } from '../data/site';
import { getGallery, getHeroImage, getOwnerImage } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const hero = getHeroImage();
const owner = getOwnerImage();
const gallery = getGallery();
const galleryUrl = pageUrl(lang, 'gallery');
---
<Base lang={lang} page="about">
  <section class="hero">
    {hero
      ? <Image class="hero-img" src={hero} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      : <div class="hero-img ph" />}
    <div class="hero-inner container">
      <div class="eyebrow">{d.hero.eyebrow}</div>
      <h1>{d.hero.title}</h1>
      <p>{d.hero.text}</p>
      <div class="hero-actions">
        <a class="btn btn-light" href={galleryUrl}>{d.hero.viewWork} <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost" href={pageUrl(lang, 'contact')}>{d.hero.getInTouch}</a>
      </div>
    </div>
  </section>

  <section class:list={['about container', { 'no-photo': !owner }]}>
    <div class="about-text">
      <div class="eyebrow">{d.about.eyebrow}</div>
      <h2>{d.about.title}</h2>
      <p class="lead">{d.about.p1}</p>
      <p class="lead">{d.about.p2}</p>
      <div class="facts">
        {d.about.facts.map((f) => (
          <div><div class="fact-title">{f.title}</div><div class="fact-text">{f.text}</div></div>
        ))}
      </div>
    </div>
    {owner && <Image class="owner" src={owner} alt={d.about.photoAlt} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />}
  </section>

  <section class="how container">
    <div class="center">
      <div class="eyebrow">{d.how.eyebrow}</div>
      <h2>{d.how.title}</h2>
    </div>
    <div class="how-grid">
      {d.how.items.map((it, i) => (
        <div class="how-card">
          <div class="num">{i + 1}</div>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="work container">
    <div class="work-head">
      <div>
        <div class="eyebrow">{d.work.eyebrow}</div>
        <h2>{d.work.title}</h2>
      </div>
      <a class="btn btn-outline" href={galleryUrl}>{d.work.viewAll} <Icon name="arrow-right" /></a>
    </div>
    <div class="cats">
      {categories.map((c) => {
        const first = gallery[c][0];
        return (
          <a class="cat" href={`${galleryUrl}#${c}`}>
            <div class:list={['cat-img', `ph ph-${c}`]}>
              {first && <Image src={first.src} alt="" widths={[320, 480, 720]} sizes="(max-width: 700px) 50vw, 20vw" />}
            </div>
            <div class="cat-name">{d.categories[c]} <span aria-hidden="true">→</span></div>
          </a>
        );
      })}
    </div>
  </section>

  <CtaBand title={d.cta.title} text={d.cta.text} emailLabel={d.cta.emailMe} />
</Base>

<style>
  .hero { position: relative; min-height: min(640px, 82vh); display: flex; align-items: flex-end; color: var(--white); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(30, 24, 20, 0.78) 0%, rgba(30, 24, 20, 0.35) 55%, rgba(30, 24, 20, 0.1) 100%);
  }
  .hero-inner { position: relative; z-index: 1; padding-block: clamp(32px, 6vw, 80px); max-width: 880px; display: flex; flex-direction: column; gap: 22px; }
  .hero .eyebrow { color: var(--wood-light); }
  .hero h1 { font-size: clamp(34px, 4.6vw, 62px); line-height: 1.1; color: var(--white); }
  .hero p { font-size: clamp(16px, 1.5vw, 20px); color: #f1e8da; max-width: 620px; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 6px; }

  section h2 { font-size: clamp(28px, 3.1vw, 42px); line-height: 1.18; }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6.5vw, 96px); align-items: center; padding-block: clamp(64px, 8vw, 112px); }
  .about.no-photo { grid-template-columns: minmax(0, 820px); }
  .about-text { display: flex; flex-direction: column; gap: 20px; }
  .owner { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 12px; padding-top: 28px; border-top: 1px solid var(--line); }
  .fact-title { font-family: var(--serif); font-size: 20px; font-weight: 600; color: var(--green); line-height: 1.25; }
  .fact-text { font-size: 14px; color: var(--muted); margin-top: 6px; line-height: 1.45; }

  .how { background: var(--sand); padding-block: clamp(64px, 8vw, 112px); }
  .center { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.2vw, 32px); margin-top: clamp(36px, 4vw, 56px); }
  .how-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(24px, 2.5vw, 36px); display: flex; flex-direction: column; gap: 14px; }
  .how-card .num { width: 48px; height: 48px; border-radius: 50%; background: var(--sand); color: var(--wood); display: grid; place-items: center; font-family: var(--serif); font-size: 20px; font-weight: 600; }
  .how-card h3 { font-size: 22px; }
  .how-card p { font-size: 15px; color: var(--muted); }

  .work { padding-block: clamp(64px, 8vw, 112px); }
  .work-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .work-head h2 { margin-top: 12px; }
  .cats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin-top: clamp(32px, 4vw, 56px); }
  .cat { display: flex; flex-direction: column; gap: 14px; }
  .cat-img { aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .cat:hover .cat-img img { transform: scale(1.04); }
  .cat-name { font-family: var(--serif); font-size: 19px; font-weight: 600; display: flex; justify-content: space-between; }
  .cat-name span { color: var(--wood); transition: transform 0.2s; }
  .cat:hover .cat-name span { transform: translateX(4px); }

  @media (max-width: 1000px) {
    .cats { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .owner { aspect-ratio: 4 / 3; }
    .how-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { min-height: 520px; }
    .hero-actions .btn { flex: 1 1 100%; }
    .facts { grid-template-columns: 1fr; gap: 16px; padding-top: 20px; }
    .fact-text { margin-top: 2px; }
    .work-head .btn { display: none; }
    .cats { grid-template-columns: 1fr 1fr; gap: 12px; }
    .cat:last-child { grid-column: span 2; }
    .cat:last-child .cat-img { aspect-ratio: 2 / 1; }
    .cat-img { aspect-ratio: 1; }
    .cat-name { font-size: 16px; }
  }
</style>
