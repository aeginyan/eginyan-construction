---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, fmt } from '../i18n';
import { categories, type Lang } from '../data/site';
import { getGallery } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const gallery = getGallery();

// Large version of each photo for the full-screen viewer.
const full = Object.fromEntries(
  await Promise.all(
    categories.map(async (c) => [
      c,
      await Promise.all(gallery[c].map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'webp' }))),
    ]),
  ),
);
const count = (n: number) => fmt(n === 1 ? d.gallery.photo : d.gallery.photos, { n });
---
<Base lang={lang} page="gallery">
  <section class="title container">
    <div>
      <div class="eyebrow">{d.work.eyebrow}</div>
      <h1>{d.gallery.title}</h1>
    </div>
    <p>{d.gallery.intro}</p>
  </section>

  <nav class="tracker" aria-label={d.gallery.title}>
    <div class="tracker-links container">
      {categories.map((c, i) => (
        <a href={`#${c}`} data-cat={c} aria-current={i === 0 ? 'true' : undefined}>
          {d.categories[c]} <span class="n">{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
    <div class="progress"><div class="progress-bar"></div></div>
  </nav>

  {categories.map((c, i) => {
    const photos = gallery[c];
    return (
      <section class="gsec" id={c} data-cat={c}>
        <div class="gsec-head container">
          <div>
            <div class="eyebrow">{String(i + 1).padStart(2, '0')} · {d.categories[c]}</div>
            <h2>{d.categories[c]}</h2>
            {photos.length > 0 && <div class="count">{count(photos.length)}</div>}
          </div>
          {photos.length > 1 && (
            <div class="arrows">
              <button class="arrow" type="button" data-dir="-1" aria-label={d.gallery.prev} disabled><Icon name="arrow-left" /></button>
              <button class="arrow" type="button" data-dir="1" aria-label={d.gallery.next}><Icon name="arrow-right" /></button>
            </div>
          )}
        </div>

        {photos.length > 0 ? (
          <>
            <div class="track" tabindex="0" aria-label={d.categories[c]}>
              {photos.map((p, n) => (
                <button class="slide" type="button" data-full={full[c][n].src} data-alt={fmt(d.gallery.photoAlt, { category: d.categories[c], n: n + 1 })}>
                  <Image
                    src={p.src}
                    alt={fmt(d.gallery.photoAlt, { category: d.categories[c], n: n + 1 })}
                    widths={[400, 640, 960, 1280]}
                    sizes="(max-width: 700px) 80vw, 520px"
                    loading={i === 0 && n < 3 ? 'eager' : 'lazy'}
                  />
                </button>
              ))}
              <div class="track-end" aria-hidden="true"></div>
            </div>
            {photos.length > 1 && (
              <div class="dots container" aria-hidden="true">
                {photos.map((_, n) => <span class:list={{ on: n === 0 }} />)}
              </div>
            )}
          </>
        ) : (
          <div class="container">
            <div class:list={['empty', `ph ph-${c}`]}><span>{d.gallery.comingSoon}</span></div>
          </div>
        )}
      </section>
    );
  })}

  <dialog class="lightbox" aria-label={d.gallery.title}>
    <img alt="" />
    <div class="lb-count"></div>
    <button class="lb-btn lb-close" type="button" aria-label={d.gallery.close}><Icon name="close" /></button>
    <button class="lb-btn lb-prev" type="button" aria-label={d.gallery.prev}><Icon name="arrow-left" /></button>
    <button class="lb-btn lb-next" type="button" aria-label={d.gallery.next}><Icon name="arrow-right" /></button>
  </dialog>

  <CtaBand title={d.gallery.ctaTitle} text={d.gallery.ctaText} emailLabel={d.cta.emailMe} />
</Base>

<script>
  /* ---------- Sticky category tracker ---------- */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tracker-links a')];
  const strip = document.querySelector<HTMLElement>('.tracker-links')!;
  const sections = [...document.querySelectorAll<HTMLElement>('.gsec')];
  const bar = document.querySelector<HTMLElement>('.progress-bar')!;

  function setActive(cat: string) {
    links.forEach((a) => {
      const on = a.dataset.cat === cat;
      if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      // On phones the strip scrolls sideways: keep the active tab in view.
      if (on && strip.scrollWidth > strip.clientWidth) {
        strip.scrollTo({ left: a.offsetLeft - (strip.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' });
      }
    });
  }

  function onScroll() {
    // Current category = last section whose top has passed the middle of the screen.
    const mid = window.innerHeight * 0.45;
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= mid) current = s;
    if (current && !links.find((a) => a.dataset.cat === current.dataset.cat)?.hasAttribute('aria-current')) {
      setActive(current.dataset.cat!);
    }
    // Progress bar: 0 when the first category reaches the tracker, 1 at the end of the last one.
    const start = sections[0].getBoundingClientRect().top + window.scrollY - strip.offsetHeight;
    const last = sections[sections.length - 1];
    const end = last.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
    const p = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
    bar.style.transform = `scaleX(${p})`;
  }
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(() => { onScroll(); ticking = false; }); }
  }, { passive: true });
  onScroll();

  /* ---------- Horizontal carousels ---------- */
  document.querySelectorAll<HTMLElement>('.gsec').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('.track');
    if (!track) return;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const [prev, next] = [...sec.querySelectorAll<HTMLButtonElement>('.arrow')];
    const dots = [...sec.querySelectorAll<HTMLElement>('.dots span')];

    const index = () => {
      const left = track.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => { if (Math.abs(s.offsetLeft - track.offsetLeft - left) < Math.abs(slides[best].offsetLeft - track.offsetLeft - left)) best = i; });
      return best;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max;
      const i = track.scrollLeft >= max ? slides.length - 1 : index();
      dots.forEach((d, n) => d.classList.toggle('on', n === i));
    };
    const go = (i: number) => {
      const s = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: s.offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    prev?.addEventListener('click', () => go(index() - 1));
    next?.addEventListener('click', () => go(index() + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });
    window.addEventListener('resize', update);
    update();

    slides.forEach((s, i) => s.addEventListener('click', () => openLightbox(slides, i)));
  });

  /* ---------- Full-screen photo viewer ---------- */
  const lb = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const lbImg = lb.querySelector('img')!;
  const lbCount = lb.querySelector<HTMLElement>('.lb-count')!;
  let lbSlides: HTMLElement[] = [];
  let lbIndex = 0;

  function show(i: number) {
    lbIndex = (i + lbSlides.length) % lbSlides.length;
    const s = lbSlides[lbIndex];
    lbImg.src = s.dataset.full!;
    lbImg.alt = s.dataset.alt ?? '';
    lbCount.textContent = `${lbIndex + 1} / ${lbSlides.length}`;
    lb.classList.toggle('single', lbSlides.length < 2);
  }
  function openLightbox(slides: HTMLElement[], i: number) {
    lbSlides = slides;
    show(i);
    lb.showModal();
  }
  lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(lbIndex - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(lbIndex + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(lbIndex + 1);
    if (e.key === 'ArrowLeft') show(lbIndex - 1);
  });
  let touchX = 0;
  lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(lbIndex + (dx < 0 ? 1 : -1));
  });
  lb.addEventListener('close', () => { lbImg.removeAttribute('src'); });
</script>

<style>
  .title { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; flex-wrap: wrap; padding-block: clamp(36px, 5vw, 72px) clamp(24px, 3vw, 40px); }
  .title h1 { font-size: clamp(34px, 3.9vw, 56px); margin-top: 10px; }
  .title p { max-width: 460px; color: var(--muted); font-size: 17px; }

  .tracker {
    position: sticky; top: 0; z-index: 20;
    background: rgba(247, 242, 234, 0.96);
    backdrop-filter: blur(8px);
    border-block: 1px solid var(--line);
    box-shadow: 0 6px 18px rgba(42, 37, 34, 0.08);
  }
  .tracker-links { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .tracker-links::-webkit-scrollbar { display: none; }
  .tracker-links a {
    flex: none; display: flex; align-items: center; gap: 10px;
    height: var(--tracker-h); padding: 0 20px;
    font-size: 15px; font-weight: 500; color: var(--muted);
    border-bottom: 3px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .tracker-links a:first-child { padding-left: 0; }
  .tracker-links a:hover { color: var(--ink); }
  .tracker-links a[aria-current='true'] { color: var(--ink); font-weight: 600; border-bottom-color: var(--wood); }
  .tracker-links .n { font-size: 12px; color: #a39888; font-weight: 500; }
  .progress { height: 3px; background: var(--line); }
  .progress-bar { height: 100%; background: var(--wood); transform-origin: left; transform: scaleX(0); }

  .gsec { padding-block: clamp(40px, 4.5vw, 64px); border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--tracker-h) + 3px); }
  .gsec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 24px; }
  .gsec-head h2 { font-size: clamp(26px, 2.5vw, 36px); margin-top: 8px; }
  .count { font-size: 14px; color: var(--muted); margin-top: 4px; }
  .arrows { display: flex; gap: 10px; }
  .arrow {
    width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--ink); background: transparent;
    display: grid; place-items: center; cursor: pointer; transition: background-color 0.15s, color 0.15s;
  }
  .arrow :global(svg) { width: 20px; height: 20px; }
  .arrow:hover:not(:disabled) { background: var(--ink); color: var(--cream); }
  .arrow:disabled { border-color: var(--line); color: #bdb2a3; cursor: default; }

  .track {
    display: flex; gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    padding-inline: var(--pad); scroll-padding-inline: var(--pad);
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide {
    flex: none; width: min(520px, 80vw); aspect-ratio: 4 / 3;
    padding: 0; border: 0; border-radius: 6px; overflow: hidden; cursor: zoom-in;
    scroll-snap-align: start; background: var(--sand);
  }
  .slide img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .slide:hover img { transform: scale(1.03); }
  .track-end { flex: none; width: 1px; }

  .dots { display: flex; gap: 8px; margin-top: 20px; }
  .dots span { width: 8px; height: 8px; border-radius: 4px; background: var(--line); transition: width 0.2s, background-color 0.2s; }
  .dots span.on { width: 24px; background: var(--wood); }

  .empty {
    width: min(520px, 100%); aspect-ratio: 4 / 3; border-radius: 6px;
    display: flex; align-items: flex-end; padding: 16px;
  }
  .empty span { background: rgba(42, 37, 34, 0.55); color: var(--white); padding: 6px 12px; border-radius: 4px; font-size: 14px; font-weight: 500; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgba(20, 16, 13, 0.94); color: var(--white);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(20, 16, 13, 0.6); }
  .lightbox img { max-width: calc(100vw - 140px); max-height: calc(100dvh - 120px); object-fit: contain; border-radius: 4px; }
  .lb-count { position: absolute; top: 24px; left: 24px; font-size: 14px; color: #cfc5b8; }
  .lb-btn {
    position: absolute; width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255, 253, 249, 0.12); border: 0; color: var(--white); cursor: pointer;
    display: grid; place-items: center;
  }
  .lb-btn:hover { background: rgba(255, 253, 249, 0.24); }
  .lb-btn :global(svg) { width: 24px; height: 24px; }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 20px; top: 50%; translate: 0 -50%; }
  .lb-next { right: 20px; top: 50%; translate: 0 -50%; }
  .lightbox.single .lb-prev, .lightbox.single .lb-next, .lightbox.single .lb-count { display: none; }

  @media (max-width: 700px) {
    :global(:root) { --tracker-h: 52px; }
    .tracker-links { gap: 2px; }
    .tracker-links a { padding: 0 12px; font-size: 14px; }
    .tracker-links .n { display: none; }
    .arrows { display: none; }
    .track { gap: 12px; }
    .lightbox img { max-width: 100vw; max-height: calc(100dvh - 160px); border-radius: 0; }
    .lb-prev, .lb-next { top: auto; bottom: 24px; translate: none; }
  }
</style>
