---
import '@fontsource-variable/lora';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, pageUrl, root } from '../i18n';
import { site, profiles } from '../data/site';
import type { Lang, Page } from '../data/site';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const d = t(lang);
const ruUrl = pageUrl('ru', page);

// Business details for search engines (schema.org).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  founder: { '@type': 'Person', name: site.owner },
  telephone: site.phoneHref.replace(/^tel:/, ''),
  email: site.email,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Metro Vancouver' },
    { '@type': 'Place', name: 'Lower Mainland' },
  ],
  knowsLanguage: ['en', 'ru', 'hy'],
  ...(profiles.length > 0 && { sameAs: profiles.map((p) => p.url) }),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.titles[page]}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="icon" type="image/svg+xml" href={`${root}/favicon.svg`} />
    {root !== '' && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en" href={pageUrl('en', page)} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl('en', page)} />
    <meta name="theme-color" content="#f7f2ea" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    {lang === 'en' && (
      <script is:inline define:vars={{ ruUrl }}>
        // Send returning visitors who picked Russian to the Russian page,
        // but only when they arrive from outside the site.
        try {
          if (localStorage.getItem('lang') === 'ru' &&
              !(document.referrer && new URL(document.referrer).host === location.host)) {
            location.replace(ruUrl + location.hash);
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
