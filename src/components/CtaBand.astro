---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props { title: string; text: string; emailLabel: string }
const { title, text, emailLabel } = Astro.props;
---
<section class="cta container">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="actions">
    <a class="btn btn-light" href={site.phoneHref}><Icon name="phone" /> {site.phoneDisplay}</a>
    <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" /> <span class="email">{site.email}</span><span class="email-short">{emailLabel}</span></a>
  </div>
</section>

<style>
  .cta {
    background: var(--green); color: var(--cream);
    display: flex; justify-content: space-between; align-items: center; gap: 32px;
    padding-block: clamp(56px, 7vw, 88px);
  }
  h2 { color: var(--cream); font-size: clamp(28px, 3vw, 40px); }
  p { color: var(--green-muted); font-size: 18px; margin-top: 10px; }
  .actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .email-short { display: none; }
  @media (max-width: 900px) {
    .cta { flex-direction: column; align-items: stretch; }
    .actions { flex-direction: column; }
    .email { display: none; }
    .email-short { display: inline; }
  }
</style>
