---
import Icon from './Icon.astro';
import { t, pageUrl } from '../i18n';
import { site, type Lang, type Page } from '../data/site';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const d = t(lang);
const pages: Page[] = ['about', 'gallery', 'contact'];
---
<header class="header">
  <div class="bar container">
    <a class="logo" href={pageUrl(lang, 'about')} aria-label={site.name}>
      <span class="mark" aria-hidden="true">E</span>
      <span class="wordmark">Eginyan<b>Construction</b></span>
    </a>

    <nav class="nav" aria-label="Main">
      {pages.map((p) => (
        <a href={pageUrl(lang, p)} aria-current={p === page ? 'page' : undefined}>{d.nav[p]}</a>
      ))}
    </nav>

    <div class="right">
      <div class="lang" role="group" aria-label={d.nav.language}>
        <a href={pageUrl('en', page)} hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a href={pageUrl('ru', page)} hreflang="ru" lang="ru" data-lang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>RU</a>
      </div>
      <a class="btn btn-green call" href={site.phoneHref}>
        <Icon name="phone" /> {site.phoneDisplay}
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" /><span class="sr-only">{d.nav.menu}</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu container" id="mobile-menu" hidden>
    {pages.map((p) => (
      <a href={pageUrl(lang, p)} aria-current={p === page ? 'page' : undefined}>{d.nav[p]}</a>
    ))}
    <a class="btn btn-green" href={site.phoneHref}><Icon name="phone" /> {d.nav.call} {site.phoneDisplay}</a>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  // Remember the visitor's language choice for their next visit.
  document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.lang!); } catch {}
    }),
  );
</script>

<style>
  .header { background: var(--cream); border-bottom: 1px solid var(--line); position: relative; z-index: 30; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 88px; }
  .logo { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .mark {
    width: 40px; height: 40px; border-radius: 6px; flex: none;
    background: var(--green); color: var(--cream);
    font-family: var(--serif); font-weight: 600; font-size: 20px;
    display: grid; place-items: center;
  }
  .wordmark { font-family: var(--serif); font-size: 22px; font-weight: 600; white-space: nowrap; }
  .wordmark b { color: var(--wood); font-weight: 600; }

  .nav { display: flex; gap: 40px; font-size: 15px; font-weight: 500; color: var(--muted); }
  .nav a { padding: 6px 0; border-bottom: 2px solid transparent; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--wood); }

  .right { display: flex; align-items: center; gap: 20px; }
  .lang { display: flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; font-size: 13px; font-weight: 600; }
  .lang a { padding: 6px 12px; border-radius: 999px; color: var(--muted); }
  .lang a:hover { color: var(--ink); }
  .lang a[aria-current='true'] { background: var(--ink); color: var(--cream); }

  .burger { display: none; background: none; border: 0; padding: 8px; margin-right: -8px; cursor: pointer; }
  .burger :global(svg) { width: 26px; height: 26px; }

  .mobile-menu { display: flex; flex-direction: column; padding-bottom: 20px; border-top: 1px solid var(--line); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a:not(.btn) { padding: 14px 0; font-size: 17px; font-weight: 500; border-bottom: 1px solid var(--line); }
  .mobile-menu a[aria-current='page'] { color: var(--wood); }
  .mobile-menu .btn { margin-top: 18px; }

  @media (max-width: 1080px) { .nav { gap: 28px; } .call { display: none; } }
  @media (max-width: 820px) {
    .bar { height: 68px; }
    .nav { display: none; }
    .burger { display: block; }
    .right { gap: 10px; }
    .mark { width: 32px; height: 32px; font-size: 16px; }
    .wordmark { font-size: 17px; }
    .lang { font-size: 12px; }
    .lang a { padding: 4px 9px; }
  }
  @media (min-width: 821px) { .mobile-menu { display: none !important; } }
  @media (max-width: 360px) { .wordmark { font-size: 15px; } .logo { gap: 8px; } }
</style>
