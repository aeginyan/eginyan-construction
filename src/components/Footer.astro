---
import { t, pageUrl } from '../i18n';
import Icon from './Icon.astro';
import { site, profiles, pages, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer class="footer container">
  <div class="wordmark">{site.name}</div>
  <div>{d.footer.area} · © {new Date().getFullYear()}</div>
  <nav aria-label="Footer">
    {pages.map((p) => <a href={pageUrl(lang, p)}>{d.nav[p]}</a>)}
  </nav>
  {profiles.length > 0 && (
    <ul class="social">
      {profiles.map((p) => (
        <li>
          <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.label} title={p.label}>
            <Icon name={p.id} />
          </a>
        </li>
      ))}
    </ul>
  )}
</footer>

<style>
  .footer {
    background: var(--ink); color: #bfb5a8; font-size: 14px;
    display: flex; justify-content: space-between; align-items: center; gap: 16px 32px; flex-wrap: wrap;
    padding-block: 48px;
  }
  .wordmark { font-family: var(--serif); font-weight: 600; font-size: 20px; color: var(--cream); }
  nav { display: flex; gap: 28px; }
  nav a:hover { color: var(--cream); }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; }
  .social a {
    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    border: 1px solid rgba(191, 181, 168, 0.35); transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .social a:hover { color: var(--cream); border-color: var(--cream); background: rgba(247, 242, 234, 0.06); }
  .social a:focus-visible { outline-color: var(--wood-light); }
  .social :global(svg) { width: 18px; height: 18px; }
  @media (max-width: 820px) {
    .footer { flex-direction: column; align-items: flex-start; padding-block: 36px; }
  }
</style>
